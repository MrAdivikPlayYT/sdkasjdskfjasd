-- Doors ------------------------------------------------------------------------------
local Pending
local Bound = setmetatable({}, { __mode = "k" })

local function Find(root, path)
    for name in path:gmatch("[^/]+") do root = root and root:FindFirstChild(name) end
    return root
end
local function OnToast(data)
    local pending = Pending
    if not pending or type(data) ~= "table" then return end
    local title, text = tostring(data.Title or ""), tostring(data.ContentText or "")
    local lower = (title .. " " .. text):lower()
    for _, word in ipairs({ "treat", "trick", "door", "cooldown", "knock", "come back" }) do
        if lower:find(word, 1, true) then pending.Title, pending.Text = title, text return end
    end
end
local function OnCamera(part, mode)
    local pending = Pending
    if pending and mode == "lock" and typeof(part) == "Instance" and part:IsDescendantOf(pending.Door) then
        pending.Locked = true
    end
end
local function Bind()
    local function bind(remote, callback)
        if remote and remote:IsA("RemoteEvent") and not Bound[remote] then
            Bound[remote] = true
            table.insert(Farm.Connections, remote.OnClientEvent:Connect(callback))
        end
    end
    bind(Find(ReplicatedStorage, "Toasts/Assets/Remotes/Display"), OnToast)
    bind(Find(ReplicatedStorage, "EventStuff/TweenCamera"), OnCamera)
end

local function PromptPosition(prompt)
    local parent = prompt.Parent
    if parent and parent:IsA("Attachment") then return parent.WorldPosition end
    if parent and parent:IsA("BasePart") then return parent.Position end
    if parent and parent:IsA("Model") then return parent:GetPivot().Position end
end
-- Door numbers have gaps (Door12, Door14...), so doors are found by name pattern, never by counting.
local function Doors()
    local list = {}
    for _, door in ipairs(workspace:GetChildren()) do
        if door:IsA("Model") and door.Name:match("^Door%d+$") then
            local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
            local position = prompt and PromptPosition(prompt)
            if position then list[#list + 1] = { Door = door, Prompt = prompt, Pos = position } end
        end
    end
    return list
end
local function Ready(entry)
    return entry.Prompt.Enabled and entry.Door.Parent ~= nil
        and (State.Cooldowns[entry.Door.Name] or 0) <= os.time()
        and (State.Retry[entry.Door.Name] or 0) <= os.clock()
end
local function GetRoot()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and humanoid and humanoid.Health > 0 then return root, character, humanoid end
end
local function RestoreCamera()
    local camera = workspace.CurrentCamera
    local _, _, humanoid = GetRoot()
    if camera and camera.CameraType == Enum.CameraType.Scriptable then
        camera.CameraType = Enum.CameraType.Custom
        if humanoid then camera.CameraSubject = humanoid end
    end
end
local function Alive(session) return Farm.Alive and State.Running and session == State.Session end

-- One knock: teleport in front of the door, press the prompt, wait for the server's result toast.
-- The game anchors the character for its door scene; the result arrives about 5.5s in, and the
-- next door can be knocked right after it without waiting for the scene to finish.
local function Knock(entry, session)
    local root, character = GetRoot()
    if not root then return nil, "Character unavailable" end
    local position = PromptPosition(entry.Prompt) or entry.Pos
    local camPart = entry.Door:FindFirstChild("CamCF", true)
    local direction = camPart and camPart:IsA("BasePart") and camPart.Position - position
    direction = direction and Vector3.new(direction.X, 0, direction.Z)
    if not direction or direction.Magnitude < 0.1 then
        local look = entry.Door:GetPivot().LookVector
        direction = Vector3.new(look.X, 0, look.Z)
    end
    if direction.Magnitude < 0.1 then return nil, "Door has no front" end
    direction = direction.Unit

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local spot = position + direction * 5
    local hit = workspace:Raycast(spot + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0), params)
    local y = (hit and hit.Normal.Y > 0.6 and hit.Position.Y <= position.Y + 1.5) and hit.Position.Y + 3 or position.Y

    root.Anchored = false
    character:PivotTo(CFrame.lookAt(Vector3.new(spot.X, y, spot.Z), Vector3.new(position.X, y, position.Z)))
    root.AssemblyLinearVelocity = Vector3.zero
    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = CFrame.lookAt(root.Position + direction * 3 + Vector3.new(0, 2, 0), position)
    task.wait(0.2)
    if not Alive(session) then return nil, "Stopped" end

    local pending = { Door = entry.Door }
    Pending = pending
    local fired, problem = pcall(fireproximityprompt, entry.Prompt, entry.Prompt.HoldDuration)
    if not fired then Pending = nil return nil, tostring(problem) end
    local started = os.clock()
    repeat
        task.wait(0.05)
        local elapsed = os.clock() - started
    until pending.Title or not Alive(session) or elapsed > 10 or (not pending.Locked and elapsed > 2.5)
    Pending = nil
    root.Anchored = false
    return pending
end

local function HandleResult(entry, pending, reason)
    local name = entry.Door.Name
    if not pending or not pending.Title then
        local locked = pending and pending.Locked
        State.Retry[name] = os.clock() + (locked and 90 or 45)
        AddLog(name, locked and "No reply" or (reason or "Not accepted"), Theme.Dim)
        return false
    end
    local cooldown = CooldownSeconds(pending.Title .. " " .. pending.Text)
    if cooldown then
        SetCooldown(name, cooldown)
        AddLog(name, "Cooldown " .. Clock(cooldown), Theme.Dim)
        return false
    end
    SetCooldown(name, 1800)
    State.Doors = State.Doors + 1
    local rewards = ParseRewards(pending.Text)
    if #rewards > 0 or pending.Title:lower():find("treat", 1, true) then
        State.Treats = State.Treats + 1
        local parts = {}
        for _, reward in ipairs(rewards) do
            if not State.Loot[reward.Name] then
                State.Loot[reward.Name] = 0
                table.insert(State.LootOrder, reward.Name)
            end
            State.Loot[reward.Name] = State.Loot[reward.Name] + reward.Amount
            parts[#parts + 1] = "+" .. Comma(reward.Amount) .. " " .. reward.Name
        end
        AddLog(name, #parts > 0 and table.concat(parts, ", ") or "Treat", Theme.Good)
        local embed = RewardEmbed(name, rewards, pending.Text)
        task.spawn(function()
            local ok, why = Post(embed)
            if State.WebhookEnabled then
                State.WebhookStatus = ok and ("Webhook sent · " .. os.date("%H:%M:%S")) or ("Webhook: " .. tostring(why))
                RefreshUI()
            end
        end)
        return true
    end
    State.Tricks = State.Tricks + 1
    AddLog(name, "Trick", Theme.Bad)
    return true
end

local function Run(session)
    Bind()
    while Alive(session) do
        local all = Doors()
        local ready = {}
        for _, entry in ipairs(all) do
            if Ready(entry) then ready[#ready + 1] = entry end
        end
        local allLooted = #all > 0
        for _, entry in ipairs(all) do
            if (State.Cooldowns[entry.Door.Name] or 0) <= os.time() then allLooted = false break end
        end
        if allLooted and State.KickWhenDone then
            -- Doors waiting for a retry are not looted yet, so this only fires once every door has a cooldown.
            SetStatus("Farm Ended", "Every door is looted · leaving")
            RestoreCamera()
            local ok, why = Post(EndedEmbed())
            if State.WebhookEnabled then State.WebhookStatus = ok and "Farm Ended sent" or ("Webhook: " .. tostring(why)) end
            task.wait(1)
            if Alive(session) and State.KickWhenDone then LocalPlayer:Kick("Farm Ended") end
            return
        end
        if #ready == 0 then
            local nextAt
            for _, entry in ipairs(all) do
                local expires = State.Cooldowns[entry.Door.Name]
                if expires and expires > os.time() and (not nextAt or expires < nextAt) then nextAt = expires end
            end
            State.SweepDone, State.SweepTotal = 0, 0
            SetStatus(#all == 0 and "Waiting for houses" or "All doors looted",
                nextAt and ("Next door in " .. Clock(nextAt - os.time())) or (#all .. " doors on this server"))
            RestoreCamera()
            task.wait(1)
        else
            local sweep = { Doors = 0, Treats = 0 }
            State.SweepDone, State.SweepTotal = 0, #ready
            while Alive(session) and #ready > 0 do
                local root = GetRoot()
                if not root then
                    SetStatus("Waiting for character", "")
                    task.wait(0.5)
                else
                    table.sort(ready, function(a, b)
                        return (root.Position - a.Pos).Magnitude < (root.Position - b.Pos).Magnitude
                    end)
                    local entry = table.remove(ready, 1)
                    if Ready(entry) then
                        SetStatus("Knocking " .. entry.Door.Name,
                            string.format("Door %d of %d", State.SweepDone + 1, State.SweepTotal))
                        local pending, reason = Knock(entry, session)
                        if not Alive(session) then break end
                        local before = State.Treats
                        if HandleResult(entry, pending, reason) then sweep.Doors = sweep.Doors + 1 end
                        sweep.Treats = sweep.Treats + (State.Treats - before)
                    end
                    State.SweepDone = State.SweepDone + 1
                    RefreshUI()
                end
            end
            RestoreCamera()
            if Alive(session) and sweep.Doors > 0 then
                local ok, why = Post(SummaryEmbed(sweep))
                if State.WebhookEnabled then
                    State.WebhookStatus = ok and ("Summary sent · " .. os.date("%H:%M:%S")) or ("Webhook: " .. tostring(why))
                end
            end
        end
    end
end

function Farm.Start()
    if State.Running or not Farm.Alive then return end
    if type(fireproximityprompt) ~= "function" then
        SetStatus("Unsupported", "This executor has no fireproximityprompt")
        return
    end
    State.Running = true
    State.Session = State.Session + 1
    local session = State.Session
    SetStatus("Starting", "Finding doors")
    task.spawn(function()
        local ok, why = xpcall(Run, function(err) return tostring(err) end, session)
        if session == State.Session then
            State.Running = false
            if not ok then SetStatus("Stopped", why) end
        end
        RestoreCamera()
        RefreshUI()
    end)
end
function Farm.Stop()
    State.Running = false
    State.Session = State.Session + 1
    Pending = nil
    local root = GetRoot()
    if root then root.Anchored = false end
    RestoreCamera()
    State.SweepDone, State.SweepTotal = 0, 0
    SetStatus("Stopped", "Press Start")
end
function Farm.Destroy()
    if State.Running then Farm.Stop() end
    Farm.Alive = false
    for _, connection in ipairs(Farm.Connections) do pcall(function() connection:Disconnect() end) end
    if Ui.Gui then Ui.Gui:Destroy() end
    if Env.DoorFarm == Farm then Env.DoorFarm = nil end
end
Farm.State = State

Ui.Start.Activated:Connect(function()
    if State.Running then Farm.Stop() else Farm.Start() end
end)
Ui.Test.Activated:Connect(function()
    State.WebhookStatus = "Sending test..."
    RefreshUI()
    task.spawn(function()
        local ok, why = Post({
            title = "🎃 Door Farm connected",
            description = "Webhook is working. Rewards will arrive here as soon as a door gives them.",
            color = 0xFF8C28,
            fields = {
                { name = "👤 Account", value = Account(), inline = true },
