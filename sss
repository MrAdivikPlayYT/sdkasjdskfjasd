-- Formatting -------------------------------------------------------------------
local function Comma(n)
    local s, replaced = tostring(math.floor(n)), 0
    repeat s, replaced = s:gsub("^(%d+)(%d%d%d)", "%1,%2") until replaced == 0
    return s
end
local function Clock(seconds)
    seconds = math.max(0, math.floor(seconds))
    local h, m, s = math.floor(seconds / 3600), math.floor(seconds % 3600 / 60), seconds % 60
    return h > 0 and string.format("%d:%02d:%02d", h, m, s) or string.format("%02d:%02d", m, s)
end
local function Escape(text) return (tostring(text or ""):gsub("([\\`*_~|>])", "\\%1")) end

local function ParseRewards(text)
    local rewards = {}
    for amount, name in tostring(text or ""):gmatch("%+%s*([%d,]+)%s+([^!\n]+)") do
        local value = tonumber((amount:gsub(",", "")))
        name = name:gsub("^%s+", ""):gsub("[%s%.!]+$", "")
        if value and name ~= "" then rewards[#rewards + 1] = { Name = name, Amount = value } end
    end
    return rewards
end
local function CooldownSeconds(text)
    text = tostring(text or ""):lower()
    if not (text:find("cooldown", 1, true) or text:find("come back", 1, true) or text:find("already", 1, true)) then
        return nil
    end
    local minutes = tonumber(text:match("(%d+)%s*min")) or 0
    local seconds = tonumber(text:match("(%d+)%s*sec")) or 0
    local total = minutes * 60 + seconds
    return total > 0 and total or 1800
end

-- Discord webhook ----------------------------------------------------------------
local function ValidURL(url)
    return type(url) == "string" and (url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil
        or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil
        or url:match("^https://ptb%.discord%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil
        or url:match("^https://canary%.discord%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil)
end
local function LootText()
    local lines = {}
    for _, name in ipairs(State.LootOrder) do
        lines[#lines + 1] = string.format("`+%s` %s", Comma(State.Loot[name]), Escape(name))
    end
    return #lines > 0 and table.concat(lines, "\n"):sub(1, 1000) or "Nothing yet"
end
local function Account()
    return string.format("||%s (@%s)||", Escape(LocalPlayer.DisplayName), Escape(LocalPlayer.Name))
end
local function SessionLine()
    return string.format("Doors **%d** · Treats **%d** · Tricks **%d** · %s",
        State.Doors, State.Treats, State.Tricks, Clock(os.clock() - State.StartedAt))
end
local function Post(embed, force)
    if not force and not State.WebhookEnabled then return false, "Webhook is off" end
    if not ValidURL(State.WebhookURL) then return false, "Enter a valid Discord webhook URL" end
    local send = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
    if type(send) ~= "function" then return false, "Executor has no HTTP request" end
    local body = HttpService:JSONEncode({ username = "Door Farm", allowed_mentions = { parse = {} }, embeds = { embed } })
    local ok, response = pcall(send, {
        Url = State.WebhookURL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body,
    })
    local code = ok and type(response) == "table" and tonumber(response.StatusCode or response.Status)
    return code ~= nil and code >= 200 and code < 300, code and ("HTTP " .. code) or "Request failed"
end
local function RewardEmbed(door, rewards, text)
    local lines = {}
    for _, reward in ipairs(rewards) do
