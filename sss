            timestamp = DateTime.now():ToIsoDate(),
        }, true)
        State.WebhookStatus = ok and ("Test sent · " .. os.date("%H:%M:%S")) or ("Test failed: " .. tostring(why))
        RefreshUI()
    end)
end)

RebuildLists()
SetStatus("Idle", #Doors() .. " doors on this server · press Start")
task.spawn(function()
    while Farm.Alive do
        RefreshUI()
        task.wait(0.5)
    end
end)
