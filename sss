        local ok, hidden = pcall(gethui)
        if ok then parent = hidden end
    end
    if not pcall(function() gui.Parent = parent or game:GetService("CoreGui") end) then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    return gui
end

